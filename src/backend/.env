NODE_ENV=development
PORT=3000

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=medicita
DB_USER=postgres
DB_PASSWORD=admin
DB_POOL_MIN=2
DB_POOL_MAX=10

# JWT — usar claves largas y aleatorias en producción
