# =============================================================
# MediCita Backend — Variables de entorno
# Copiar como .env y completar valores reales
# NUNCA commitear el archivo .env al repositorio
# =============================================================

NODE_ENV=development
PORT=3000

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=medicita
DB_USER=root
DB_PASSWORD=admin
DB_POOL_MIN=2
DB_POOL_MAX=10

# JWT — usar claves largas y aleatorias en producción
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=cambia_este_secreto_access_en_produccion
JWT_REFRESH_SECRET=cambia_este_secreto_refresh_en_produccion
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Cifrado AES-256 para datos clínicos (32 bytes = 64 caracteres hex)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=cambia_esta_clave_de_cifrado_en_produccion_32b

# CORS — origenes permitidos (separados por coma)
CORS_ORIGINS=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
