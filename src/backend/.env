# =============================================================
# MediCita Backend — Variables de entorno
# =============================================================

NODE_ENV=development
PORT=3000

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=medicita
DB_USER=postgres
DB_PASSWORD=medicita_password_2026
DB_POOL_MIN=2
DB_POOL_MAX=10

# JWT — usar claves largas y aleatorias en producción
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=tu_secreto_access_super_seguro_desarrollo_local_123456789
JWT_REFRESH_SECRET=tu_secreto_refresh_super_seguro_desarrollo_local_987654321
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Cifrado AES-256 para datos clínicos (32 bytes = 64 caracteres hex)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=22c31c636a22c4313ffae75be40bae289005862d8c80cbd812ccc55c1a643cd6

# CORS — origenes permitidos
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Logging
LOG_LEVEL=debug
# ═════════════════════════════════════════════════════════════
# SMTP — Configuración de correos electrónicos
# ═════════════════════════════════════════════════════════════
# Para Gmail/Google Workspace:
# 1. Habilitar "Acceso a aplicaciones menos seguras" o usar contraseña de aplicación
# 2. Si tienes 2FA habilitado, usa una contraseña de aplicación en lugar de tu contraseña actual
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=preyvictoria@gmail.com
SMTP_PASS=dtmtotoxqlgpdezk

# ═════════════════════════════════════════════════════════════
# ADMIN — Datos del administrador médico
# ═════════════════════════════════════════════════════════════
ADMIN_EMAIL=preyvictoria@gmail.com
ADMIN_NAME=Médico Administrador

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100